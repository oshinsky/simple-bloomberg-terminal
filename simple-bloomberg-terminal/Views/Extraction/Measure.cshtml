@model simple_bloomberg_terminal.Models.ViewModels.MeasureViewModel
@{ ViewData["Title"] = "Extraction measurement"; }

<div class="page-header">
    <h2><span class="page-header-accent">//</span> Extraction measurement — COST</h2>
    <div class="page-subtitle">
        Runs the full pipeline N times over the same filing — fast workers AND lead agent, graded
        separately · repeatability + evidence presence scored automatically · precision is the
        manual pass over the blank <code>judgement</code> column
    </div>
</div>

<div class="form-card" id="measureForm">
    @Html.AntiForgeryToken()
    <div class="form-card-title">Targets</div>
    <div class="form-stack">
        <div>
            <label class="form-label" for="Targets">One filing per line — <code>companyId, accession, doc[, form]</code></label>
            <textarea class="form-control" id="Targets" rows="5"
                      placeholder="12, 0000002488-25-000012, amd-20241228.htm, 10-K">@Model.Targets</textarea>
            <div class="form-text">
                Every run is a FULL pipeline run — its own worker scan plus its own lead call — and runs
                execute concurrently (up to 10 at a time). Section selection is deterministic: every
                detected heading is scanned, ranked by relevance to the chunk budget.
            </div>
        </div>
        <div>
            <label class="form-label" for="Runs">Runs per filing</label>
            <input class="form-control" id="Runs" type="number" min="2" max="20" value="@Model.Runs" style="max-width:8rem">
        </div>
        <div>
            <label class="form-label" for="StrictCounterparties">Extraction mode</label>
            <select class="form-select" id="StrictCounterparties" style="max-width:22rem">
                @if (Model.StrictCounterparties)
                {
                    <option value="false">Less strict extraction (current prompt)</option>
                    <option value="true" selected>Strict extraction</option>
                }
                else
                {
                    <option value="false" selected>Less strict extraction (current prompt)</option>
                    <option value="true">Strict extraction</option>
                }
            </select>
            <div class="form-text">Strict mode requires an explicit transaction or concrete commercial collaboration.</div>
        </div>
    </div>
    <div class="form-actions">
        <button type="button" class="btn btn-primary" id="measureRun">Run measurement</button>
        <span id="measureStatus" class="form-text"></span>
    </div>
</div>

@* ── Live tracker ───────────────────────────────────────────────────────────────────────────── *@
<div class="form-card" id="trackerCard" hidden>
    <div class="form-card-title">Progress</div>
    <div id="trackerBody"></div>
</div>

<script>
(function () {
    const btn = document.getElementById('measureRun');
    const statusEl = document.getElementById('measureStatus');
    const card = document.getElementById('trackerCard');
    const body = document.getElementById('trackerBody');
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    let started = null;
    const elapsed = () => {
        const s = Math.round((new Date() - started) / 1000);
        return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    };

    btn.addEventListener('click', async () => {
        const payload = {
            targets: document.getElementById('Targets').value,
            runs: Number(document.getElementById('Runs').value) || 2,
            strictCounterparties: document.getElementById('StrictCounterparties').value === 'true'
        };
        btn.disabled = true;
        btn.textContent = 'Running…';
        started = new Date();
        card.hidden = false;

        let res;
        try {
            res = await fetch('/extraction/measure/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                body: JSON.stringify(payload)
            });
        } catch (e) { return fail('Network error: ' + e.message); }
        if (!res.ok) return fail('Failed to start: ' + await res.text());

        const { jobId } = await res.json();
        poll(jobId);
    });

    function fail(msg) {
        btn.disabled = false;
        btn.textContent = 'Run measurement';
        statusEl.textContent = msg;
    }

    // 1s poll. The tracker is the only reason this batch is detached, so it must stay cheap: the
    // status DTO carries counts and titles, never the evidence text or the finished rows.
    async function poll(jobId) {
        let res;
        try { res = await fetch(`/extraction/measure/status/${jobId}`); }
        catch { return setTimeout(() => poll(jobId), 2000); }
        if (!res.ok) return fail('Job not found.');

        const job = await res.json();
        render(job);

        if (job.status === 'Done') { window.location = `/extraction/measure/result/${jobId}`; return; }
        if (job.status === 'Error') return fail(job.error || 'Measurement failed.');
        setTimeout(() => poll(jobId), 1000);
    }

    const PHASE = {
        queued: 'queued', scanning: 'fast worker agents',
        'lead-agent': 'lead agent', done: 'done'
    };

    function render(job) {
        statusEl.textContent = `${elapsed()} elapsed · ${job.runs.length} run(s) reporting`;
        body.innerHTML = job.runs.map(r => {
            const pct = r.chunksTotal ? Math.round(100 * r.chunksDone / r.chunksTotal) : 0;
            // Only the chunks that have reported are worth listing — a wall of "Queued" rows for
            // every run at once buries the ones actually moving.
            const active = r.chunks
                .map((c, i) => ({ ...c, i }))
                .filter(c => c.status !== 'Queued');
            return `
              <div style="margin-bottom:1rem;padding-bottom:.75rem;border-bottom:1px solid var(--border-subtle);">
                <div style="display:flex;gap:.75rem;align-items:baseline;flex-wrap:wrap;">
                  <strong>${esc(r.filing)} · run ${r.run}</strong>
                  <span class="tag-cell">${esc(PHASE[r.phase] || r.phase)}</span>
                  <span class="muted-cell">${r.chunksDone}/${r.chunksTotal} chunks (${pct}%)</span>
                  <span class="muted-cell">fast worker: ${r.fastWorkerClaims} claims</span>
                  ${r.errors ? `<span class="impact-badge impact-high">${r.errors} errors</span>` : ''}
                  <span class="muted-cell">lead agent: ${r.phase === 'done' ? r.leadAgentClaims + ' claims' : '…'}</span>
                </div>
                <details style="margin-top:.4rem;">
                  <summary class="muted-cell" style="cursor:pointer;">chunk detail (${active.length})</summary>
                  <div style="margin-top:.35rem;font-family:var(--font-mono);font-size:.85em;">
                    ${active.map(c => `
                      <div style="display:flex;gap:.5rem;">
                        <span style="width:5rem;flex:none;" class="${c.status === 'Error' ? 'impact-badge impact-high' : 'muted-cell'}">${esc(c.status)}</span>
                        <span style="width:3rem;flex:none;text-align:right;">${c.status === 'Done' ? c.found : ''}</span>
                        <span class="muted-cell">${esc((c.titles || []).join(' · ') || '(section body)')}
                          ${c.error ? `<span class="impact-badge impact-high" style="margin-left:.4rem;white-space:normal;">${esc(c.error)}</span>` : ''}
                        </span>
                      </div>`).join('')}
                  </div>
                </details>
              </div>`;
        }).join('');
    }
})();
</script>

<style>
    .measure-summary { display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:.65rem;margin:1rem 0; }
    .measure-summary-card { padding:.7rem .85rem;border:1px solid var(--border-subtle);background:var(--bg-surface); }
    .measure-summary-value { display:block;font-family:var(--font-mono);font-size:1.25rem;color:var(--text-primary); }
    .measure-tabs { display:flex;gap:.4rem;flex-wrap:wrap;margin:.8rem 0; }
    .measure-tab { border:1px solid var(--border-subtle);background:transparent;color:var(--text-secondary);padding:.4rem .7rem;cursor:pointer; }
    .measure-tab.is-active { border-color:var(--accent);color:var(--accent);background:var(--border-accent); }
    .measure-panel[hidden] { display:none; }
    .measure-frequency { display:flex;align-items:center;gap:.55rem;white-space:nowrap; }
    .measure-dots { letter-spacing:.12rem;color:var(--accent);font-size:.9rem; }
    .measure-dots .off { color:var(--border-subtle); }
    .measure-status { display:inline-flex;padding:.15rem .4rem;border:1px solid currentColor;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em; }
    .measure-status.stable { color:var(--green); }
    .measure-status.warning { color:var(--accent); }
    .measure-status.problem { color:var(--red); }
    .measure-counterparty-detail summary { cursor:pointer;list-style:none; }
    .measure-counterparty-detail summary::-webkit-details-marker { display:none; }
    .measure-aliases { margin-top:.25rem;font-size:.78rem;color:var(--text-muted); }
    .measure-detail-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:.75rem;padding:.75rem;background:var(--bg-surface); }
    @@media (max-width: 760px) {
        .measure-comparison { min-width:48rem; }
    }
</style>

@if (Model.Results.Count > 0)
{
    @foreach (var r in Model.Results)
    {
        <div class="form-card">
            <div class="form-card-title" style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;">
                <span>@r.Company</span>
                <span class="muted-cell" style="font-weight:normal;">
                    @r.Accession · @r.Runs runs · @r.Model · @r.RunAt.ToString("yyyy-MM-dd HH:mm")Z
                    · @(Model.StrictCounterparties ? "strict extraction" : "less strict extraction")
                </span>
            </div>

            @if (r.Error is not null)
            {
                <div class="alert alert-danger">@r.Error</div>
            }
            else
            {
                <div class="presence-matrix" data-accession="@r.Accession" style="margin-top:1rem;"></div>

                @if (r.TotalErrors > 0)
                {
                    <div class="alert alert-warning" style="margin-top:.75rem;">
                        Some worker calls failed. A failed worker returns no candidates, which is
                        indistinguishable from a chunk that honestly contained none — so the fast layer's
                        items may be incomplete. Re-run before reporting these.
                    </div>
                }
            }
        </div>
    }

    @* ── Annotation grid — the manual precision pass ────────────────────────────────────────── *@
    <div class="form-card">
        <div class="form-card-title" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;">
            <span>Review — judge each claim</span>
            <span style="display:flex;gap:.75rem;align-items:center;">
                <label class="form-label" for="layerPick" style="margin:0;">Layer</label>
                <select class="form-select" id="layerPick" style="width:auto">
                    <option value="LEAD_AGENT">Lead agent</option>
                    <option value="FAST_WORKER">Fast worker agents</option>
                </select>
                <label class="form-label" for="runPick" style="margin:0;">Run</label>
                <select class="form-select" id="runPick" style="width:auto"></select>
                <span id="precisionOut" class="muted-cell"></span>
            </span>
        </div>
        <div class="form-text">
            Precision is measured over ONE run of ONE layer. Switch to Fast workers to judge the raw
            per-chunk output. Click a row's evidence to read the full quote and open the filing there.
        </div>
        <div style="overflow-x:auto">
            <table class="terminal-table" id="reviewTable">
                <thead>
                <tr>
                    <th>Counterparty</th><th>Direction</th><th>What</th>
                    <th>Section</th><th>Evidence</th><th>Judgement</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-title">Result sheet — one row per (filing, run, item)</div>
        <textarea class="form-control" id="csvBox" rows="10" readonly style="font-family:var(--font-mono)"></textarea>
        <div class="form-actions">
            <button type="button" class="btn btn-secondary" id="csvDownload">Download CSV</button>
        </div>
    </div>

    <script>
    (function () {
        const ROWS = @Html.Raw(Model.RowsJson ?? "[]");

        // Three precision buckets, including one for a real quote that names a company which is not
        // a commercial counterparty at all (a competitor, a plaintiff) — that failure is
        // invisible to the evidence-presence check, so it needs its own bucket rather than being forced
        // into "wrongly classified".
        const JUDGEMENTS = ['', 'ISPRAVNA', 'POGRESNO_KLASIFICIRANA', 'NIJE_COUNTERPARTY'];

        const runPick = document.getElementById('runPick');
        const layerPick = document.getElementById('layerPick');
        const tbody = document.querySelector('#reviewTable tbody');
        const csvBox = document.getElementById('csvBox');
        const precisionOut = document.getElementById('precisionOut');
        const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        // Keep browser grouping aligned with the harness identity normalizer.
        const COMPANY_SUFFIXES = new Set([
            'inc', 'corp', 'corporation', 'co', 'ltd', 'limited', 'llc', 'plc', 'gmbh', 'ag',
            'sa', 'nv', 'ab', 'as', 'oy', 'kk'
        ]);

        // The default result view answers the paper-facing questions first: which canonical company
        // was found, whether the two layers agree, and whether its direction is stable. The wide
        // per-run matrices remain available under Raw runs for audit and annotation.
        function renderMeasurementComparisons() {
            const normalizedCompanyKey = name => {
                const words = String(name || '').toLocaleLowerCase()
                    .replace(/[^\p{L}\p{N}]+/gu, ' ').trim().split(/\s+/).filter(Boolean);
                const ends = suffix => suffix.every((word, i) => words[words.length - suffix.length + i] === word);
                if (ends(['l', 'l', 'c'])) words.splice(-3);
                else if (ends(['s', 'a']) || ends(['n', 'v'])) words.splice(-2);
                while (words.length && COMPANY_SUFFIXES.has(words[words.length - 1])) words.pop();
                return words.join(' ');
            };

            document.querySelectorAll('.presence-matrix').forEach(host => {
                const filingRows = ROWS.filter(r => r.accession === host.dataset.accession);
                const filingRuns = [...new Set(filingRows.map(r => r.run))].sort((a, b) => a - b);
                const groups = new Map();

                filingRows.forEach(row => {
                    const key = normalizedCompanyKey(row.counterparty);
                    if (!key) return;
                    if (!groups.has(key)) groups.set(key, {
                        names: new Set(), directions: new Set(),
                        fastWorkerRuns: new Set(), leadAgentRuns: new Set(),
                        fastWorkerRows: [], leadAgentRows: []
                    });
                    const group = groups.get(key);
                    group.names.add(row.counterparty);
                    if (row.direction) group.directions.add(String(row.direction).toUpperCase());
                    const layerRows = row.layer === 'FAST_WORKER'
                        ? group.fastWorkerRows : group.leadAgentRows;
                    const layerRuns = row.layer === 'FAST_WORKER'
                        ? group.fastWorkerRuns : group.leadAgentRuns;
                    layerRows.push(row);
                    layerRuns.add(row.run);
                });

                const items = [...groups.values()].map(group => {
                    const names = [...group.names].sort((a, b) => b.length - a.length || a.localeCompare(b));
                    const directionConflict = group.directions.size > 1;
                    const stable = !directionConflict &&
                        group.fastWorkerRuns.size === filingRuns.length &&
                        group.leadAgentRuns.size === filingRuns.length;
                    let status = stable ? 'Stable'
                        : directionConflict ? 'Direction conflict'
                        : group.fastWorkerRuns.size > group.leadAgentRuns.size ? 'Lead-agent variance'
                        : group.fastWorkerRuns.size === 0 ? 'Lead-agent only'
                        : group.leadAgentRuns.size === 0 ? 'Fast-worker only'
                        : 'Unstable';
                    return { ...group, names, primary: names[0], directionConflict, stable, status };
                }).sort((a, b) => {
                    if (a.stable !== b.stable) return a.stable ? 1 : -1;
                    const deltaA = Math.abs(a.fastWorkerRuns.size - a.leadAgentRuns.size);
                    const deltaB = Math.abs(b.fastWorkerRuns.size - b.leadAgentRuns.size);
                    return deltaB - deltaA || b.fastWorkerRuns.size - a.fastWorkerRuns.size ||
                        a.primary.localeCompare(b.primary);
                });

                const dots = runs => `<span class="measure-frequency"><span class="measure-dots">${
                    filingRuns.map(run => runs.has(run) ? '●' : '<span class="off">●</span>').join('')
                }</span><strong>${runs.size}/${filingRuns.length}</strong></span>`;
                const statusClass = item => item.stable ? 'stable'
                    : item.directionConflict || item.status.endsWith('only') ? 'problem' : 'warning';

                const detail = item => `<div class="measure-detail-grid">
                    <div><div class="ext-field-label">Aliases</div><div class="muted-cell">${esc(item.names.join(' · '))}</div></div>
                    <div><div class="ext-field-label">Directions observed</div><div class="muted-cell">${esc([...item.directions].join(' · ') || '—')}</div></div>
                    <div><div class="ext-field-label">Per-run presence</div>
                        ${filingRuns.map(run => `<div class="muted-cell">Run ${run}: fast worker ${item.fastWorkerRuns.has(run) ? 'YES' : '—'} · lead agent ${item.leadAgentRuns.has(run) ? 'YES' : '—'}</div>`).join('')}
                    </div>
                </div>`;

                const comparisonTable = subset => `<div style="overflow-x:auto"><table class="terminal-table measure-comparison" style="width:100%;">
                    <thead><tr><th>Counterparty</th><th>Direction</th><th>Fast workers</th><th>Lead agent</th><th>Status</th></tr></thead>
                    <tbody>${subset.length ? subset.map(item => `<tr>
                        <td class="name-cell"><details class="measure-counterparty-detail"><summary>${esc(item.primary)} <span class="muted-cell">▾</span></summary>${detail(item)}</details></td>
                        <td class="tag-cell">${esc([...item.directions].join(' / ') || '—')}</td>
                        <td>${dots(item.fastWorkerRuns)}</td><td>${dots(item.leadAgentRuns)}</td>
                        <td><span class="measure-status ${statusClass(item)}">${esc(item.status)}</span></td>
                    </tr>`).join('') : '<tr><td colspan="5" class="muted-cell">No counterparties in this group.</td></tr>'}</tbody>
                </table></div>`;

                const rawLayer = (layer, title) => {
                    const rows = filingRows.filter(row => row.layer === layer);
                    const rawGroups = new Map();
                    rows.forEach(row => {
                        const key = `${String(row.direction || '').toUpperCase()}|${normalizedCompanyKey(row.counterparty)}`;
                        if (!rawGroups.has(key)) rawGroups.set(key, { names:new Set(), direction:row.direction || '—', runs:new Set() });
                        rawGroups.get(key).names.add(row.counterparty);
                        rawGroups.get(key).runs.add(row.run);
                    });
                    return `<div style="margin-top:.9rem;overflow-x:auto"><div class="ext-field-label">${esc(title)}</div>
                        <table class="terminal-table" style="min-width:44rem"><thead><tr><th>Counterparty</th><th>Direction</th>${filingRuns.map(run => `<th>Run ${run}</th>`).join('')}<th>Frequency</th></tr></thead>
                        <tbody>${[...rawGroups.values()].map(group => `<tr><td class="name-cell">${esc([...group.names].sort((a,b)=>b.length-a.length)[0])}</td><td class="tag-cell">${esc(group.direction)}</td>${filingRuns.map(run => `<td class="num-cell">${group.runs.has(run) ? 'YES' : '—'}</td>`).join('')}<td class="num-cell"><strong>${group.runs.size}/${filingRuns.length}</strong></td></tr>`).join('')}</tbody></table></div>`;
                };

                const stable = items.filter(item => item.stable);
                const disagreements = items.filter(item => !item.stable);
                const conflicts = items.filter(item => item.directionConflict).length;
                const leadAgentDrops = items.filter(
                    item => item.fastWorkerRuns.size > item.leadAgentRuns.size).length;
                host.innerHTML = `<div class="measure-summary">
                    <div class="measure-summary-card"><span class="measure-summary-value">${items.length}</span><span class="muted-cell">counterparties</span></div>
                    <div class="measure-summary-card"><span class="measure-summary-value">${stable.length}</span><span class="muted-cell">stable</span></div>
                    <div class="measure-summary-card"><span class="measure-summary-value">${disagreements.length}</span><span class="muted-cell">need attention</span></div>
                    <div class="measure-summary-card"><span class="measure-summary-value">${conflicts}</span><span class="muted-cell">direction conflicts</span></div>
                    <div class="measure-summary-card"><span class="measure-summary-value">${leadAgentDrops}</span><span class="muted-cell">lead-agent variances</span></div>
                </div>
                <div class="measure-tabs">
                    <button type="button" class="measure-tab is-active" data-tab="issues">Disagreements (${disagreements.length})</button>
                    <button type="button" class="measure-tab" data-tab="consensus">Consensus (${stable.length})</button>
                    <button type="button" class="measure-tab" data-tab="raw">Raw runs</button>
                </div>
                <div class="measure-panel" data-panel="issues">${comparisonTable(disagreements)}</div>
                <div class="measure-panel" data-panel="consensus" hidden>${comparisonTable(stable)}</div>
                <div class="measure-panel" data-panel="raw" hidden>${rawLayer('FAST_WORKER','Fast worker agents')}${rawLayer('LEAD_AGENT','Lead agent')}</div>`;

                host.querySelectorAll('.measure-tab').forEach(button => button.addEventListener('click', () => {
                    host.querySelectorAll('.measure-tab').forEach(tab => tab.classList.toggle('is-active', tab === button));
                    host.querySelectorAll('.measure-panel').forEach(panel => panel.hidden = panel.dataset.panel !== button.dataset.tab);
                }));
            });
        }

        // Judgements live on the row objects, so switching runs and re-rendering never loses them.
        ROWS.forEach(r => {
            r.judgement = '';
            r.extractionMode = '@(Model.StrictCounterparties ? "STRICT" : "LESS_STRICT")';
        });

        const runs = [...new Set(ROWS.map(r => r.run))].sort((a, b) => a - b);
        runs.forEach(n => runPick.add(new Option('Run ' + n, n)));

        // The filing on EDGAR, opened at the passage: #:~:text= is the browser's native text
        // fragment, so no viewer of our own is needed.
        //
        // Two things the fragment syntax demands that are easy to get wrong:
        //
        // 1. It is COMMA-DELIMITED — text=[prefix-,]start[,end][,-suffix] — and encodeURIComponent
        //    does NOT escape commas. A quote containing them is parsed as several parts and silently
        //    fails. (One comma is the trap: it parses as a valid start,end pair and still highlights
        //    something, so the bug hides until a quote has two or more.) Hyphens delimit the
        //    prefix-/-suffix markers, so they are escaped for the same reason.
        // 2. A match must begin and end on a WORD BOUNDARY, so a quote may never be cut mid-word.
        //    Long quotes therefore use the start,end range form over whole words rather than a
        //    character truncation — which also survives the whitespace the rendered filing inserts
        //    in the middle of a long passage.
        const encFrag = s => encodeURIComponent(s).replace(/,/g, '%2C').replace(/-/g, '%2D');

        function secUrl(r) {
            const cik = String(r.cik || '').replace(/^0+/, '');
            const acc = String(r.accession || '').replace(/-/g, '');
            const base = `https://www.sec.gov/Archives/edgar/data/${cik}/${acc}/${r.doc}`;
            const quote = String(r.evidence || '').replace(/\s+/g, ' ').trim();
            if (!quote) return base;
            if (quote.length <= 100) return `${base}#:~:text=${encFrag(quote)}`;
            const words = quote.split(' ');
            const start = words.slice(0, 6).join(' ');
            const end = words.slice(-6).join(' ');
            return `${base}#:~:text=${encFrag(start)},${encFrag(end)}`;
        }

        const inView = r => r.run === Number(runPick.value) && r.layer === layerPick.value;

        function render() {
            tbody.innerHTML = '';
            ROWS.filter(inView).forEach(r => {
                const tr = document.createElement('tr');
                tr.innerHTML =
                    `<td class="name-cell">${esc(r.counterparty)}</td>` +
                    `<td class="tag-cell">${esc(r.direction || '—')}</td>` +
                    `<td class="muted-cell">${esc(r.what || '—')}</td>` +
                    `<td class="tag-cell">${esc(r.section || '—')}</td>` +
                    `<td class="muted-cell" style="max-width:26rem;">` +
                        `<div class="evidence-link" role="button" tabindex="0">evidence ▾</div>` +
                        `<div class="ev-full" hidden style="margin-top:.35rem;white-space:pre-wrap;">` +
                            `${esc(r.evidence || '(none)')}` +
                            `<div style="margin-top:.35rem;"><a href="${esc(secUrl(r))}" target="_blank" rel="noopener">open filing ↗</a></div>` +
                        `</div></td>` +
                    `<td></td>`;

                const sel = document.createElement('select');
                sel.className = 'form-select';
                JUDGEMENTS.forEach(j => sel.add(new Option(j || '— judge —', j)));
                sel.value = r.judgement || '';
                sel.addEventListener('change', () => { r.judgement = sel.value; refresh(); });
                tr.lastElementChild.appendChild(sel);

                const toggle = tr.querySelector('.evidence-link');
                const full = tr.querySelector('.ev-full');
                toggle.addEventListener('click', () => {
                    full.hidden = !full.hidden;
                    toggle.textContent = full.hidden ? 'evidence ▾' : 'evidence ▴';
                });

                tbody.appendChild(tr);
            });
            refresh();
        }

        // Precision = share of JUDGED rows marked correct, over the run being reviewed. Judged, not
        // all — an unannotated row is missing data, and counting it as wrong would make precision
        // read 0% at the start of every session and creep up as an artefact of how far you have got.
        function refresh() {
            const inRun = ROWS.filter(inView);
            const judged = inRun.filter(r => r.judgement);
            const ok = judged.filter(r => r.judgement === 'ISPRAVNA').length;
            precisionOut.textContent = judged.length === 0
                ? `0 / ${inRun.length} judged`
                : `precision ${(100 * ok / judged.length).toFixed(1)}% · ${judged.length} / ${inRun.length} judged`;
            csvBox.value = toCsv();
        }

        // The single CSV writer. It lives here rather than server-side because `judgement` is filled
        // in this table — generating it in C# would mean a second writer producing a stale column.
        const COLS = ['extractionMode', 'layer', 'company', 'cik', 'accession', 'doc', 'run', 'counterparty', 'direction',
            'what', 'evidence', 'section', 'judgement'];
        // Quote text, leave numbers/booleans bare so Excel reads them as numbers and COUNTIF works.
        const cell = v => v == null ? ''
            : (typeof v === 'number' || typeof v === 'boolean') ? String(v).toUpperCase()
            : `"${String(v).replace(/"/g, '""').replace(/[\r\n]+/g, ' ')}"`;
        const toCsv = () => [COLS.join(',')]
            .concat(ROWS.map(r => COLS.map(c => cell(r[c])).join(',')))
            .join('\n');

        runPick.addEventListener('change', render);
        layerPick.addEventListener('change', render);
        renderMeasurementComparisons();
        render();

        document.getElementById('csvDownload').addEventListener('click', () => {
            const blob = new Blob([csvBox.value], { type: 'text/csv;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'extraction-measurement.csv';
            a.click();
            URL.revokeObjectURL(a.href);
        });

        // The annotations are in-memory only; a reload loses them and the run costs real money.
        window.addEventListener('beforeunload', e => {
            if (ROWS.some(r => r.judgement)) { e.preventDefault(); e.returnValue = ''; }
        });
    })();
    </script>
}
